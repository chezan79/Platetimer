entrypoint = "server.js"
modules = ["nodejs-22", "python-3.11"]
hidden = [".config", "package-lock.json"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json", "package-lock.json"]

[nix]
channel = "stable-24_11"
packages = ["openssh", "mcron"]

[deployment]
run = ["sh", "-c", "node server.js"]
deploymentTarget = "autoscale"
ignorePorts = false

[workflows]
runButton = "Run Server"

[[workflows.workflow]]
name = "Run Server"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 node server.js"
waitForPort = 5000

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 4454
externalPort = 5000

[[ports]]
localPort = 4455
externalPort = 4200

[[ports]]
localPort = 4456
externalPort = 5173

[[ports]]
localPort = 4457
externalPort = 6000

[[ports]]
localPort = 4458
externalPort = 6800

[[ports]]
localPort = 4460
externalPort = 8000

[[ports]]
localPort = 4461
externalPort = 8008

[[ports]]
localPort = 4462
externalPort = 8080

[[ports]]
localPort = 4463
externalPort = 8081

[[ports]]
localPort = 4464
externalPort = 8099

[[ports]]
localPort = 4465
externalPort = 9000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5097
externalPort = 3001

[[ports]]
localPort = 5098
externalPort = 3002

[[ports]]
localPort = 5099
externalPort = 3003

[agent]
expertMode = true

[userenv]

[userenv.shared]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
